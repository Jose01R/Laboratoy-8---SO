	$(COPY_FILE) --parents ../../dialogchargingstation.ui ../../dialogcounter.ui ../../dialogmessenger.ui ../../dialogmutex.ui ../../dialogprodcons.ui ../../mainwindow.ui $(DISTDIR)/


